# Editor config — personal, not tracked in the repo
.idea/
.vscode/
.claude

# Python bytecode cache
__pycache__/
*.pyc
pyright-report.*

# Virtual environment
venv/
.venv/

# Local archive working directories
source/
staging/
restored/
LOCAL_MANIFEST_ARCHIVE/
backup_logs/
storage_map_logs/
# Everything here stays untracked. This repo is PUBLIC, and storage_map/logs/
# holds real lab data: scan rawlogs, and under deletions/ the ledger plus
# per-file inventories naming every archived file and its owner. The deletion
# ledger is the durable record of what was removed from a server, so keep
# backups of it off-repo (it cannot be regenerated once the data is gone).
storage_map/logs/
storage_map/index.html
db_backups/
tape_reset_audits/
lto_archive*.db

# Local config — contains host/user/paths. Use config.example.ini as template.
config.ini

# Vendor drivers/installers — proprietary, not redistributed (see README).
Framework & Drivers/

# Secrets — real credentials live here, never commit them
.env
.env.*
!.env.example

# Private operational data — real manifests, tape state, incident evidence,
# infrastructure identities. This repo is PUBLIC; everything under private/
# stays local by construction.
private/

# Databases and dumps — the catalog lives in PostgreSQL, never in the repo
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
*.bak
*.restore_list.txt
*.receipt.json

# Logs and generated runtime state
*.log
logs/
tmp/
temp/
cache/
storage_map/coverage_baseline.json

# Local scratch output from storage_map dev sessions
storage_map/scratch_coverage.json
storage_map/scratchpad_serve.log

# Generated snapshots — regenerable, and they embed real inventory
docs/storage_map_*.html
deliverables/
