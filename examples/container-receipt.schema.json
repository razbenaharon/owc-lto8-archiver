{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/razbenaharon/owc-lto8-archiver/examples/container-receipt.schema.json",
  "title": "Container receipt (receipt.json)",
  "description": "Published beside the stored-TAR containers of one archive chunk. The receipt is the integrity anchor for those containers: it records, per container, the exact byte size and SHA-256, so an intact container can be told from a truncated or corrupted one without reading tape or re-fetching the source.",
  "type": "object",
  "required": ["schema_version", "chunk_index", "session_id", "containers",
               "expected_totals", "observed_totals"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": 1},
    "chunk_index": {"type": "integer", "minimum": 0,
                    "description": "remote_chunks.chunk_index this receipt covers"},
    "session_id": {"type": "integer", "minimum": 0},
    "session_label": {"type": "string",
                      "description": "Stable session key. Publishing note: real labels embed the source host name, so treat them as private operational metadata."},
    "plan_id": {"type": "integer", "minimum": 0},
    "completed_at": {"type": "string", "format": "date-time"},
    "tool_version": {"type": "string"},
    "membership_fingerprint": {"$ref": "#/$defs/sha256"},
    "missing_members": {
      "type": "array", "items": {"type": "string"},
      "description": "Planned members absent from the containers. A non-empty list makes the chunk ineligible for archive completion."
    },
    "expected_totals": {"$ref": "#/$defs/totals"},
    "observed_totals": {
      "$ref": "#/$defs/totals",
      "description": "Must equal expected_totals; any divergence means the chunk did not materialize as planned."
    },
    "containers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["container_ordinal", "tar_locator", "tar_size", "tar_sha256",
                     "member_count", "logical_bytes"],
        "additionalProperties": true,
        "properties": {
          "container_id": {"type": "integer"},
          "container_ordinal": {"type": "integer", "minimum": 0},
          "tar_locator": {"type": "string",
                          "description": "Root-relative path so the store can be relocated"},
          "tar_size": {"type": "integer", "minimum": 0,
                       "description": "Exact on-disk byte length; the truncation check"},
          "tar_sha256": {"$ref": "#/$defs/sha256"},
          "sidecar_locator": {"type": "string"},
          "sidecar_size": {"type": "integer", "minimum": 0},
          "sidecar_sha256": {"$ref": "#/$defs/sha256"},
          "member_count": {"type": "integer", "minimum": 0},
          "logical_bytes": {"type": "integer", "minimum": 0,
                            "description": "Sum of member sizes, before TAR padding"},
          "transport_mode": {"type": "string", "enum": ["plain_tar"]}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "totals": {
      "type": "object",
      "required": ["member_count", "logical_bytes"],
      "properties": {
        "member_count": {"type": "integer", "minimum": 0},
        "logical_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
